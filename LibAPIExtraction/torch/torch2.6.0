         if (PyErr_Occurred()) {\n                    return nullptr;\n                }\n                return pack_tensor_handle_list(output_handles);\n            } catch(std::exception const& e) {\n                PyErr_SetString(PyExc_RuntimeError, e.what());\n                return nullptr;\n            } catch(...) {\n                PyErr_SetString(PyExc_RuntimeError, "unhandled error");\n                return nullptr;\n            }\n        }\n        ')
